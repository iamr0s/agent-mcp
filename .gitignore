# Python bytecode & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
ENV/

# Local secrets & runtime configuration (keep *.example.json templates)
.env
.env.*
!.env.example
config/*.json
!config/*.example.json
mcp_config.json
mcp_oauth_state.json
mcp_sub_servers.json
mcp_window_state.json
*.key
*.pem
*.p12

# Runtime data, WebView cache, logs & downloaded binaries (e.g. cloudflared)
data/
logs/
bin/
*.log

# Legacy / migration archive
_legacy/

# OS & desktop shortcut artifacts
*.lnk
*.desktop
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
